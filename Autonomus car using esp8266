  const canvas3D = document.getElementById('canvas3D'), ctx3D = canvas3D.getContext('2d');
  let targetRotX = 0, targetRotY = 0, currRotX = 0, currRotY = 0;
  const cubeNodes = [[-18,-18,-18],[18,-18,-18],[18,18,-18],[-18,18,-18],[-18,-18,18],[18,-18,18],[18,18,18],[-18,18,18]];
  const cubeEdges = [[0,1],[1,2],[2,3],[3,0],[4,5],[5,6],[6,7],[7,4],[0,4],[1,5],[2,6],[3,7]];

  function render3D() {
    ctx3D.clearRect(0,0, canvas3D.width, canvas3D.height);
    currRotX += (targetRotX - currRotX) * 0.1; currRotY += (targetRotY - currRotY) * 0.1;
    let projNodes = [], cx = canvas3D.width / 2, cy = canvas3D.height / 2;
    for (let p of cubeNodes) {
      let x1 = p[0] * Math.cos(currRotY) + p[2] * Math.sin(currRotY);
      let z1 = -p[0] * Math.sin(currRotY) + p[2] * Math.cos(currRotY);
      let y2 = p[1] * Math.cos(currRotX) - z1 * Math.sin(currRotX);
      let z2 = p[1] * Math.sin(currRotX) + z1 * Math.cos(currRotX);
      let scale = 100 / (100 + z2);
      projNodes.push([cx + x1 * scale, cy + y2 * scale]);
    }
    ctx3D.strokeStyle = '#a855f7'; ctx3D.lineWidth = 1.5;
    for (let e of cubeEdges) {
      ctx3D.beginPath(); ctx3D.moveTo(projNodes[e[0]][0], projNodes[e[0]][1]);
      ctx3D.lineTo(projNodes[e[1]][0], projNodes[e[1]][1]); ctx3D.stroke();
    }
    requestAnimationFrame(render3D);
  }
