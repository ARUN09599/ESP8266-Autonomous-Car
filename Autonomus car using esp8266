  function stopMove() { activeCmd = null; sendCmd('/S'); }
  function delay(ms) { return new Promise(resolve => setTimeout(resolve, ms)); }

  async function sendTimedCmd(cmd, duration) {
    if (abortRequested) return;
    sendCmd(cmd);
    let elapsed = 0;
    while (elapsed < duration) {
      if (abortRequested) { sendCmd('/S'); return; }
      await delay(50); elapsed += 50;
    }
    sendCmd('/S'); await delay(250);
