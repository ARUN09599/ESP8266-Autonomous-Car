    ctxSonar.strokeStyle = 'rgba(0,255,102,0.15)';
    for (let r = 12; r <= 45; r += 12) {
      ctxSonar.beginPath(); ctxSonar.arc(cx, cy, r, 0, Math.PI * 2); ctxSonar.stroke();
    }
    sonarAngle += 0.05;
    ctxSonar.strokeStyle = '#00ff66'; ctxSonar.lineWidth = 1.5;
