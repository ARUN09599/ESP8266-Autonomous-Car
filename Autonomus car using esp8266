#include <ESP8266WiFi.h>
#include <ESP8266WebServer.h>

const char* ssid = "realme C21";
const char* password = "";

ESP8266WebServer server(80);

// Motor Pins (L298N Driver - Speed Control via PWM)
#define IN1 D1
#define IN2 D2
#define IN3 D3
#define IN4 D4

int motorSpeed = 255;

void setup() {
  Serial.begin(115200);
  
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);
  stopCar();

  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("\nConnected! IP Address: ");
  Serial.println(WiFi.localIP());

  server.on("/", handleRoot);
  server.on("/F", []() { forward(); server.send(200, "text/plain", "OK"); });
  server.on("/B", []() { backward(); server.send(200, "text/plain", "OK"); });
  server.on("/L", []() { left(); server.send(200, "text/plain", "OK"); });
  server.on("/R", []() { right(); server.send(200, "text/plain", "OK"); });
  server.on("/S", []() { stopCar(); server.send(200, "text/plain", "OK"); });
  
  server.on("/SPEED", []() {
    if (server.hasArg("val")) {
      motorSpeed = server.arg("val").toInt();
      motorSpeed = constrain(motorSpeed, 0, 255);
    }
    server.send(200, "text/plain", "OK");
  });

  server.begin();
}

void loop() {
  server.handleClient();
}

// --- PWM CONTROLLED MOTORS ---
void forward() {
  analogWrite(IN1, motorSpeed); digitalWrite(IN2, LOW);
  analogWrite(IN3, motorSpeed); digitalWrite(IN4, LOW);
}

void backward() {
  digitalWrite(IN1, LOW); analogWrite(IN2, motorSpeed);
  digitalWrite(IN3, LOW); analogWrite(IN4, motorSpeed);
}

void left() {
  digitalWrite(IN1, LOW); analogWrite(IN2, motorSpeed);
  analogWrite(IN3, motorSpeed); digitalWrite(IN4, LOW);
}

void right() {
  analogWrite(IN1, motorSpeed); digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW); analogWrite(IN4, motorSpeed);
}

void stopCar() {
  digitalWrite(IN1, LOW); digitalWrite(IN2, LOW);
  digitalWrite(IN3, LOW); digitalWrite(IN4, LOW);
}

