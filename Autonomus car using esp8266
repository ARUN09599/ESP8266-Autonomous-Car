  function sendCmd(path) {
    let speed = parseInt(document.getElementById('remoteSpeed').value);
    if (path === '/F') { targetRotX = -0.5; targetRotY = 0; playBeep(523); }
    else if (path === '/B') { targetRotX = 0.5; targetRotY = 0; playBeep(440); }
    else if (path === '/L') { targetRotY = -0.8; targetRotX = 0; playBeep(587); }
    else if (path === '/R') { targetRotY = 0.8; targetRotX = 0; playBeep(659); }
